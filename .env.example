# Copy to .env (git-ignored). Shared by the web app (VITE_* only), the API and the worker.
# Values below match a local Supabase stack started with `npx supabase start`
# (the CLI prints the keys; the local defaults are public development values).

# --- Web app (built into the browser bundle; never put secrets here) ---
VITE_SERVER_URL=http://127.0.0.1:8010
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# --- Backend: database, storage and auth (Supabase) ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Only needed for HS256 tokens (the local CLI's legacy secret); new projects sign with ES256
SUPABASE_JWT_SECRET=
STORAGE_BUCKET=documents

# --- AI provider (see src/shared/ai/src/edu_ai/llm.py) ---
# gemini: free Gemini API key from https://aistudio.google.com/apikey (local development)
# vertex: Vertex AI on Google Cloud (production; also needs GOOGLE_CLOUD_PROJECT)
LLM_PROVIDER=gemini
LLM_API_KEY=
# Free tier: gemini-3.5-flash allows only ~20 requests/day; flash-lite is more generous
LLM_CHAT_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash
LLM_EMBEDDING_MODEL=gemini-embedding-001
# Optional per-task models: LLM_TUTOR_MODEL, LLM_GENERATION_MODEL, LLM_MARKING_MODEL, LLM_OCR_MODEL

# --- Usage limits per user per day (optional) ---
MAX_DOCUMENT_UPLOADS_PER_DAY=5
MAX_QUIZ_GENERATIONS_PER_DAY=10
MAX_FLASHCARD_GENERATIONS_PER_DAY=10
MAX_CHAT_MESSAGES_PER_DAY=50
