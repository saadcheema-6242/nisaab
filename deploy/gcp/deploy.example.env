# Copy this file to deploy.env (git-ignored) and fill it in. Used by deploy.sh.
# Everything runs in one Google Cloud project; the script creates the database,
# storage bucket, logins and services itself. No secrets go in this file: the
# database password is generated and kept in Secret Manager.

# --- Google Cloud ---
PROJECT_ID=
# Region for Cloud Run, Cloud SQL and Cloud Storage (asia-south1 = Mumbai)
REGION=asia-south1
# Vertex AI location for Gemini ("global" has the widest model availability)
VERTEX_LOCATION=global

# --- Database (Cloud SQL for PostgreSQL) ---
# db-f1-micro is the smallest shared-core tier (about $10/month)
SQL_TIER=db-f1-micro

# --- AI models (Vertex AI) ---
LLM_TUTOR_MODEL=gemini-3.5-flash
LLM_GENERATION_MODEL=gemini-3.5-flash
LLM_MARKING_MODEL=gemini-3.5-flash
LLM_OCR_MODEL=gemini-3.5-flash
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash
LLM_EMBEDDING_MODEL=gemini-embedding-001

# --- Cost controls ---
# false: the worker scales to zero and Cloud Scheduler calls POST /drain every
#        minute (pennies per month; jobs may wait up to ~1 minute to start)
# true:  one worker instance always on (~$1.60/day); use for demo days
WORKER_ALWAYS_ON=false
WORKER_CONCURRENCY=3
# 1 keeps one API instance warm (no cold start on the first request); 0 scales to zero
API_MIN_INSTANCES=0

# Optional budget alerts at about $50, $150 and $250 of BUDGET_AMOUNT
BILLING_ACCOUNT_ID=
BUDGET_AMOUNT=300

# Subject teachers who review the shared SLO content (comma-separated emails).
# They sign up in the app with these emails; a "Review content" page appears for them.
REVIEWER_EMAILS=

# Daily limits per student (optional; defaults: 100 chat messages, 30 quizzes/SRQs,
# 20 flashcard sets, 10 uploads)
# MAX_CHAT_MESSAGES_PER_DAY=100
# MAX_QUIZ_GENERATIONS_PER_DAY=30

# --- Image search (Wikimedia Commons) ---
# Wikimedia's User-Agent policy wants a way to reach whoever runs the client.
# A string that only describes the client is refused with a bare 403: every
# search from Cloud Run came back 403, ten out of ten, until this carried a
# URL. It must be a page that actually loads - a dead URL reads the same as
# no contact at all.
MEDIA_SEARCH_CONTACT=https://nisaab.muhammadsaadcheema.com

# --- Where the site is served (Firebase Hosting) ---
# Every domain sign-in must work from, comma separated. The deploy PATCHes the
# whole authorized-domain list, so a domain added by hand in the console is
# wiped by the next deploy and Google sign-in then fails on it with
# auth/unauthorized-domain and nothing to say why. Both are wanted at once:
# naming only one silently removes the other. The first is used as the site's
# own address in deploy output and as the Wikimedia contact URL.
WEB_DOMAIN=nisaab.muhammadsaadcheema.com,fbisenisaab.muhammadsaadcheema.com

# --- API reference (Scalar, served at the API root) ---
# Off unless this says otherwise. The OpenAPI spec names every route, every
# field and every shape the service accepts: the map you would want before
# writing a client against someone else's API. Every endpoint is guarded
# regardless, so publishing it is not an unlocked door, it is the plans left
# on the doorstep. Set to true to show the reference, then set it back.
# Generating the web client does not need it: scripts/export_openapi.py
# builds the spec in process without the server running.
API_DOCS=false
